# Copy to .env and fill in. Never commit .env.
# Names are case-insensitive. Full reference: ENV.md
# No real secrets belong in this file.

# =============================================================================
# LLM (required unless AGENT_FAKE_MODEL=1)
# =============================================================================
# UPSTREAM=
# MODEL=
UPSTREAM_API_KEY=
VISION_MODEL=
CONTEXT_WINDOW=32768
MAX_COMPLETION_TOKENS=8192
ENABLE_THINKING=true
UPSTREAM_TOP_EFFORT=xhigh
PROVIDER=openai
SMALL_MODEL=
FALLBACK_PROVIDER=
FALLBACK_MODEL=
FALLBACK_API_KEY=
MODELS_FREE_ONLY=false
VISION_TIMEOUT=300
MAX_IMAGE_BYTES=8388608
REQUEST_TIMEOUT=1800
STREAM_IDLE_TIMEOUT=240
CONNECT_TIMEOUT=10
MODEL_LISTING_TIMEOUT=15

# =============================================================================
# Fake model (tests and local UI without an upstream)
# =============================================================================
AGENT_FAKE_MODEL=false

# =============================================================================
# Auth
# =============================================================================
# SECRET_KEY=            # required, min 32 characters. openssl rand -base64 48
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
FIRST_USER_IS_ADMIN=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:5173

# =============================================================================
# Data stores
# =============================================================================
DATABASE_URL=postgresql+asyncpg://docu:docu@localhost:5432/docu
DATABASE_ECHO=false
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=docu:
CACHE_SEARCH_TTL=3600
CACHE_FETCH_TTL=86400
CELERY_BROKER_URL=

# =============================================================================
# Storage
# =============================================================================
FILE_STORAGE=local
UPLOAD_DIR=uploads
S3_BUCKET=docu
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_UPLOAD_BYTES=26214400
MAX_FILE_CHARS=12000

# =============================================================================
# Mail
# =============================================================================
MAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=docu@localhost

# =============================================================================
# Billing (Stripe test mode only; plan amounts are FR-034 placeholders)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CREDIT_MARGIN=1.3

# =============================================================================
# Product placeholders (FR-037, FR-038)
# =============================================================================
DATA_REGION=local
RETENTION_DAYS=30

# =============================================================================
# Agent loop
# =============================================================================
MAX_STEPS=24
SETUP_ALLOWANCE=12
AUTO_CONTINUE_STEPS=8
EMPTY_REPLY_RETRIES=4
UPSTREAM_RETRIES=2
REPEAT_LIMIT=2
BUDGET_FLOOR=4096
BUDGET_MARGIN=1024
ESTIMATE_SAFETY=1.15
CLIP_KEEP=2
CLIP_CHARS=600
CONTEXT_SUMMARIZE_RATIO=0.55
CONTEXT_KEEP_RECENT=6
CONTEXT_SUMMARIZE_AFTER_MESSAGES=24
APPROVAL_TIMEOUT=600
# SETUP_TOOLS, SCHEMA_ONLY_TOOLS, REPEAT_GUARDED_TOOLS, BUDGET_CEILING,
# CLIP_MARK, APPROVAL_REQUIRED_TOOLS, APPROVAL_REQUIRED_MCP_TOOLS use code defaults.

# =============================================================================
# Skills, memory, prompts, web, MCP
# =============================================================================
MAX_SKILL_CHARS=24000
# SKILL_DIRS and SKILL_ALLOWLIST use code defaults.
MAX_USER_SKILLS=20
MAX_USER_SKILL_BODY_CHARS=12000
MAX_MEMORY_ITEMS=50
MAX_MEMORY_CHARS=400
PROMPT_DIR=prompts
SEARCH_RESULTS=8
FETCH_TIMEOUT=30
MAX_PAGE_CHARS=8000
MCP_ENABLED=true
MCP_CONFIG_PATH=mcp.json
MCP_REQUIRE_APPROVAL=false
MAX_MCP_SERVERS_PER_USER=20
MCP_CONNECT_TIMEOUT_SEC=45
MCP_MAX_INSTRUCTIONS_CHARS=8000
MCP_MAX_UPLOAD_BYTES=26214400
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=

# =============================================================================
# Observability
# =============================================================================
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=docu
